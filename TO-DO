## TODO-01: uSockets internal ABI dependency
# Severity: Deployment risk
# File: telemetry/TelemetryBridge.cpp:31
#
# #include "internal/internal.h" uses uSockets internal headers.
# Any uSockets version update can break TelemetryBridge at runtime.
# The static_assert on struct size provides a canary but doesn't prevent
# semantic changes to the callback mechanism.
#
# Fix: Use public uSockets APIs (us_poll, us_create_socket_context) or
# submit a feature request for pipe integration. Alternatively, use a
# separate thread with blocking read() + uWS::Loop::defer() to post
# messages into the event loop.

## TODO-02: No JSON library — hand-rolled parser is fragile
# Severity: Medium
# Files: enforcer/MitigationEngine.cpp:29-90
#
# extract_str() and extract_int() use naive string scanning. Fails on:
# - Keys with escaped quotes
# - Whitespace between key and colon
# - Unicode-escaped keys
# - Nested objects with duplicate keys at different depths
#
# An attacker who compromises a node's Ed25519 key could craft evidence
# that misleads field extraction (wrong pid, wrong src_ip).
#
# Fix: Add a header-only JSON library (nlohmann/json, RapidJSON, simdjson).

## TODO-03: No structured logging
# Severity: Operational
# Files: All — std::cout/std::cerr throughout
#
# All logging is ad-hoc format strings to stdout/stderr. No log levels,
# no correlation IDs, no machine-parseable format. Makes production
# debugging, alerting, and log aggregation painful.
#
# Fix: Add a lightweight structured logger (spdlog, or a simple JSON
# logger) with levels (DEBUG, INFO, WARN, ERROR, CRITICAL).


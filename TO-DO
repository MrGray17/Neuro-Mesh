## BUG-11: std::atomic::store() in signal handler — not async-signal-safe
# Severity: MEDIUM
# Files: main.cpp:114-118
#
# POSIX only allows async-signal-safe functions in signal handlers.
# std::atomic::store() is not on the list. On glibc/x86_64 it uses lock-free
# instructions and works in practice, but on other platforms it may use a mutex
# internally, causing deadlock if the signal interrupts a thread holding that mutex.
#
# Fix: Use volatile sig_atomic_t:
#   static volatile sig_atomic_t global_running = 1;
#   void signal_handler(int) { global_running = 0; }

## BUG-12: std::jthread stop token not connected to m_running — potential deadlock
# Severity: MEDIUM
# Files: consensus/MeshNode.cpp:181, consensus/MeshNode.cpp:1328-1343
#
# tls_worker_loop() checks m_running, not the jthread stop token.
# If MeshNode is destroyed without stop() (e.g., exception during init),
# jthread destructor requests stop but the worker is blocked in cv.wait().
# The destructor deadlocks waiting for the thread to join.
#
# Fix: Use std::thread instead of std::jthread (consistent with other threads),
# or pass stop_token to the loop and check it in the cv wait predicate.

